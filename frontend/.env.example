# Copy this file to .env and adjust if your backends run somewhere else.
#
# Agents-Pipeline (Phase 7-11) — the main agentic API this dashboard talks
# to: Planner + specialists + Report Agent + conversation memory.
VITE_AGENTS_API_URL=http://localhost:8001

# RAG-Pipeline (Phase 6) — optional. Only used for the "RAG online" status
# dot in the top bar; the dashboard's Ask/Weather/Market/Recommendation
# flow works fully without it.
VITE_RAG_API_URL=http://localhost:8000
