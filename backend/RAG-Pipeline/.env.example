# Copy this file to .env and fill in what you need.
# Only the variables for your chosen LLM_PROVIDER matter — the others are ignored.

# Which LLM backend to use: ollama | groq | openai_compatible

LLM_PROVIDER=ollama

# --- ollama (free, fully local — default) 
# 1. Install from https://ollama.com
# 2. Run: ollama pull llama3
# 3. Run: ollama serve   (usually starts automatically)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- groq (free-tier cloud API, serves Llama 3 / Gemma / Mistral fast) 
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- openai_compatible (OpenRouter, Together AI, LM Studio, vLLM, etc.) 
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=


# Retrieval tuning

RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.35
MAX_CONTEXT_WORDS=2500


# LLM generation tuning

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2


# API server

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

LOG_LEVEL=INFO
