# Copy this file to .env and fill in what you need.
#
# LLM / embedding / retrieval settings (LLM_PROVIDER, OLLAMA_MODEL,
# RETRIEVAL_TOP_K, etc.) are NOT duplicated here — Agents-Pipeline
# reuses ../RAG-Pipeline's .env / config.py for those. Copy
# ../RAG-Pipeline/.env.example -> ../RAG-Pipeline/.env too.

# ---------------------------------------------------------------------------
# Planner Agent
# ---------------------------------------------------------------------------
# keyword -> fast, free, deterministic routing (default)
# llm      -> ask the LLM to route (slower, handles ambiguous phrasing better)
PLANNER_MODE=keyword
PLANNER_MAX_AGENTS_PER_REQUEST=4

# ---------------------------------------------------------------------------
# Weather Agent (Open-Meteo — free, no API key required)
# ---------------------------------------------------------------------------
WEATHER_PROVIDER=open-meteo
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_DEFAULT_LOCATION_NAME=Colombo, Sri Lanka
WEATHER_DEFAULT_LATITUDE=6.9271
WEATHER_DEFAULT_LONGITUDE=79.8612
WEATHER_FORECAST_DAYS=3
WEATHER_REQUEST_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Market Agent
# ---------------------------------------------------------------------------
MARKET_PRICE_CURRENCY=LKR

# ---------------------------------------------------------------------------
# Report Agent
# ---------------------------------------------------------------------------
REPORT_MAX_TOKENS=900

# ---------------------------------------------------------------------------
# Government PDF Search tool (Phase 9)
# ---------------------------------------------------------------------------
# Defaults to ../Document-Processing-Pipeline/output/{clean_text,metadata} —
# only set these if you moved that pipeline's output folder.
# DOCUMENT_CLEAN_TEXT_DIR=
# DOCUMENT_METADATA_DIR=
GOVERNMENT_PDF_SEARCH_TOP_K=3
GOVERNMENT_PDF_SEARCH_SNIPPET_CHARS=600

# ---------------------------------------------------------------------------
# Image Agent / Image Model tool (Phase 9)
# ---------------------------------------------------------------------------
# Which vision MODEL/provider to use (OLLAMA_VISION_MODEL, GROQ_VISION_MODEL,
# OPENAI_COMPATIBLE_VISION_MODEL) is configured in ../RAG-Pipeline/.env —
# copy ../RAG-Pipeline/.env.example there too. This pipeline only owns the
# upload-side limit:
IMAGE_MAX_BYTES=8388608

# ---------------------------------------------------------------------------
# Multi-Agent Collaboration (Phase 10)
# ---------------------------------------------------------------------------
# sequential -> agents run one at a time, each sees every earlier agent's
#               findings (default — see README's "Multi-Agent Collaboration")
# parallel    -> Phase 7's original independent fan-out (lower latency,
#               no cross-agent context)
COLLABORATION_MODE=sequential

# ---------------------------------------------------------------------------
# Conversation Memory (Phase 11)
# ---------------------------------------------------------------------------
# Set to false to disable memory recall/persistence entirely, even when
# callers pass a session_id (see README's "Conversation Memory").
MEMORY_ENABLED=true
# How many recent questions / weather checks to keep per session before
# older entries roll off.
MEMORY_MAX_TURNS=10
MEMORY_MAX_WEATHER_HISTORY=5

# ---------------------------------------------------------------------------
# API server (separate port from RAG-Pipeline/api.py so both can run
# side by side)
# ---------------------------------------------------------------------------
AGENTS_API_HOST=0.0.0.0
AGENTS_API_PORT=8001
AGENTS_API_CORS_ORIGINS=*

LOG_LEVEL=INFO
